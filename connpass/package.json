{
  "name": "@gdgjp/connpass",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/home.spec.ts e2e/api.spec.ts",
    "test:e2e:live": "CONNPASS_E2E_LIVE=1 playwright test e2e/live.spec.ts",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply gdgjp-connpass-db --local && pnpm schema:dump",
    "migrate:remote": "wrangler d1 migrations apply gdgjp-connpass-db --remote && pnpm schema:dump",
    "schema:dump": "bash ../scripts/dump-schema.sh",
    "openapi:lint": "redocly lint --config openapi/redocly.yaml openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml --output openapi/dist/openapi.yaml",
    "openapi:generate": "pnpm openapi:bundle && openapi-typescript openapi/dist/openapi.yaml -o openapi/types.generated.ts"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.5",
    "@gdgjp/gdg-lib": "workspace:*",
    "@react-router/cloudflare": "~7.13.0",
    "isbot": "^5.1.17",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.0.9",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "~7.13.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.28.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.49.1",
    "@react-router/dev": "~7.13.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "~4.112.0"
  }
}
