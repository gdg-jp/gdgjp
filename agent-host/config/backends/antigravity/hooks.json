{
  "acl-gate": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ACL_GATE_BACKEND=antigravity GDG_GWS_ALLOWLIST_PATH=/opt/gdg-agent/lib/antigravity-permissions.json /usr/bin/node /opt/gdg-agent/lib/acl-gate.ts /opt/gdg-agent/bin/wk /opt/gdg-agent/bin/gws",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
