{
  "permissions": {
    "allow": [
      "Shell(wk)",
      "Shell(/opt/gdg-agent/bin/wk)",
      "Shell(gws)",
      "Shell(/opt/gdg-agent/bin/gws)",
      "Read(**)",
      "Grep(**)",
      "List(**)",
      "Mcp(gdg-index, search)"
    ],
    "deny": []
  },
  "approvalMode": "allowlist",
  "sandbox": {
    "mode": "enabled",
    "readBoundary": "workspace",
    "networkAccess": "user_config_only",
    "networkAllowlist": ["www.googleapis.com"]
  },
  "networkAllowlistReasons": {
    "www.googleapis.com": "Discovery documents and the Drive API for the approved gwsAllowlist entries (drive files list/get)"
  }
}
