  "checks": [
    {
      "name": "SendNeedsDraftApproval",
      "expect": "holds",
      "property": "Nothing is sent unless a lead, the host chapter's organizer, or an admin approved the draft.",
      "harm": "A post or a mail to every participant goes out although nobody with approval rights approved it."
    },
    {
      "name": "SendRunsAsChapterMember",
      "expect": "holds",
      "property": "Every send for an account runs as a member of that account's chapter who approved that target.",
      "harm": "Someone outside a chapter posts from that chapter's X account or connpass group."
    },
    {
      "name": "OneSendPerTargetApproval",
      "expect": "holds",
      "property": "One approval of a dispatch target causes at most one send.",
      "harm": "The same post or mail goes out twice."
    },
    {
      "name": "SentVersionWasApproved",
      "expect": "finding",
      "property": "When people act through the pages and requests may overlap, the version that goes out was the latest version at a moment when the draft was approved.",
      "harm": "Text that nobody approved is posted or mailed under a chapter's name.",
      "finding": "F1"
    },
    {
      "name": "SentVersionWasApprovedWhenSerial",
      "expect": "holds",
      "property": "When requests do not overlap, the version that goes out was the latest version at a moment when the draft was approved.",
      "harm": "Text that nobody approved is posted or mailed under a chapter's name."
    },
    {
      "name": "SentVersionWasChapterApprovedInOrderlyUse",
      "expect": "finding",
      "property": "When people act one at a time through the pages, the version that goes out for an account was the latest version when that account's chapter approved the target.",
      "harm": "A chapter's approval of one text sends a later text it never approved.",
      "finding": "F2"
    },
    {
      "name": "DraftApproverSawSentVersionInOrderlyUse",
      "expect": "finding",
      "property": "When people act one at a time through the pages, the version that goes out was on the draft approver's screen when they pressed approve.",
      "harm": "The approver approves a text they have not read.",
      "finding": "F3"
    },
    {
      "name": "ChapterApproverSawSentVersionInOrderlyUse",
      "expect": "finding",
      "property": "When people act one at a time through the pages, a version the draft approver saw, sent for an account, was also on that chapter approver's screen when they approved the target.",
      "harm": "A chapter member approves sending a text they have not read from their chapter's account.",
      "finding": "F4"
    },
    {
      "name": "XPostGoesOut",
      "expect": "reachable"
    },
    {
