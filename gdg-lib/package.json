{
  "name": "@gdgjp/gdg-lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth/claims": "./src/auth/claims.ts",
    "./acl": "./src/acl/index.ts",
    "./acl/agent": "./src/acl/agent.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/app-links": "./src/ui/app-links.ts"
  },
  "scripts": {
    "typecheck": "pnpm build:acl && tsc --noEmit",
    "pretest": "pnpm build:acl",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:acl": "esbuild src/acl/agent.ts --bundle --format=esm --platform=neutral --banner:js='// @ts-nocheck' --outfile=../cli/internal/wiki/hooks/acl.ts",
    "build": "node scripts/build-publish-package.mjs",
    "publish:gh-packages": "cd dist && npm publish"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "openid-client": "^6.1.7"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0",
    "radix-ui": ">=1.4.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
