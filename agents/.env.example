# GDG Accounts OAuth (Stage 5d)
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
ACCOUNTS_URL=https://accounts.gdgs.jp

# Redis (replay protection + Chat SDK state + link records)
REDIS_URL=redis://127.0.0.1:6379

# Wiki agent API (Stage 5b / 5e)
WIKI_API_URL=https://wiki.gdgs.jp
# Optional origin for citation links (defaults to WIKI_API_URL)
# WIKI_PUBLIC_URL=https://wiki.gdgs.jp

# Google Chat webhook verification — Chat app project number (JWT aud)
# Example / local: 428142970890
GOOGLE_CHAT_AUDIENCE=

# Discord Ed25519 public key (Interactions endpoint verification)
# Example / local: e9957ee98bf5afc6c788b528d67f9bd33d6b6836ede6d6f2b264cbcf157d7f02
DISCORD_PUBLIC_KEY=

# AES-256-GCM keyring for OAuth access and refresh tokens at rest (Stage 5d).
# JSON map of version → base64(32-byte key), e.g. {"1":"<base64>"}.
# Encrypt with the highest version; keep old versions for decrypt until re-linked/refreshed.
TOKEN_ENCRYPTION_KEYS=

# Chat SDK adapter credentials (required to construct platform adapters)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# JSON service-account key, or set GOOGLE_CHAT_USE_ADC=true
GOOGLE_CHAT_CREDENTIALS=

# Vertex AI Gemini (Stage 5e ToolLoopAgent)
# Use a Vertex AI API key with access to the Vertex AI API; never expose it to clients.
GOOGLE_VERTEX_API_KEY=
# Optional Vertex Gemini model id (default gemini-2.5-flash)
# AGENT_MODEL=gemini-2.5-flash
