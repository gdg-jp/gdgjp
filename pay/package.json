{
  "name": "@gdgjp/pay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && node ../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply gdgjp-pay-db --local && pnpm schema:dump",
    "migrate:remote": "wrangler d1 migrations apply gdgjp-pay-db --remote && pnpm schema:dump",
    "schema:dump": "bash ../scripts/dump-schema.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gdgjp/gdg-lib": "workspace:*",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "~7.14.2",
    "@gdgjp/design-system": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@react-router/dev": "~7.14.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.10",
    "wrangler": "~4.113.0"
  }
}
