# Secrets — set as production secrets with `wrangler secret put <NAME>`.
# HMAC key for the RP's signed session + OIDC transaction cookies.
# Generate with `openssl rand -base64 48`.
RP_SESSION_SECRET=""
# Client secret issued by the accounts IdP for this RP. Must equal the value set
# as PR_CLIENT_SECRET on the accounts worker.
IDP_CLIENT_SECRET=""
# The OCI runner token for /api/runner/* (32+ chars). Generate with `openssl rand -hex 24`.
RUNNER_TOKEN=""
# Encrypts chapters' Discord webhook URLs in D1. Generate with `openssl rand -base64 32`.
SETTINGS_ENCRYPTION_KEY=""

# Override prod URLs from wrangler.toml so dev points at the local accounts IdP.
# APP_URL must be http://localhost:5191 in dev or gdg-lib marks cookies Secure
# and sign-in breaks over plain HTTP.
APP_URL=http://localhost:5191
ACCOUNTS_URL=http://localhost:5173
IDP_URL=http://localhost:5173
IDP_CLIENT_ID=pr
# Enables /dev/login locally (it 404s when ENVIRONMENT === "production").
ENVIRONMENT=development

# Local only: render images with the Playwright server e2e/render-server.ts starts (Browser
# Rendering does not run locally). Leave unset in production.
PR_RENDER_URL=http://127.0.0.1:5298/snapshot
