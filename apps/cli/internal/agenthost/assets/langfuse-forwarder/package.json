{
  "name": "@gdgjp/langfuse-forwarder",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Reads xangi's logs/observability/*.jsonl and forwards it to Langfuse Cloud JP as sessions/traces/observations.",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langfuse/otel": "5.10.1",
    "@langfuse/tracing": "5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
