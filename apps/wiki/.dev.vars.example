# Copy this file to .dev.vars and fill in real values for local development.
# Wrangler reads .dev.vars as secrets during `pnpm dev`.
# Never commit .dev.vars — it is gitignored.

# Secrets — set as production secrets with `wrangler secret put <NAME>`.
# HMAC key for the RP's signed session + OIDC transaction cookies.
# Generate with `openssl rand -base64 48`.
RP_SESSION_SECRET=
# Client secret issued by the accounts IdP for this RP.
IDP_CLIENT_SECRET=

# Override prod URLs from wrangler.toml so dev points at the local accounts IdP.
# wiki's RR7 dev server runs on a different port from accounts (5173).
APP_URL=http://localhost:5177
ACCOUNTS_URL=http://localhost:5173
IDP_URL=http://localhost:5173

# Optional — only needed for AI ingestion/translation features
GEMINI_API_KEY=
TRANSLATION_MODEL_ID=@cf/meta/m2m100-1.2b
TRANSLATION_AI_GATEWAY_ID=gdgjp-wiki-translation

# Optional for local AI generation observability. Leave both values empty to use
# the direct Gemini fallback in local development. In production, set
# AI_GATEWAY_BASE_URL as a Wrangler var and AI_GATEWAY_TOKEN with
# `wrangler secret put`; do not put either production value in this file.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_TOKEN=

# Google Drive / Docs direct import. The Picker key must be restricted to the
# local/prod web origins and Google Picker API. The project number must match
# the project that owns GOOGLE_DOCS_CLIENT_ID (or leave blank to derive it).
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Discord — reminders + /sources channel import. Client id/secret power the
# user OAuth guild picker; the bot token reads channel history after invite.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
WIKI_DISCORD_SECRET=

ENVIRONMENT=development
