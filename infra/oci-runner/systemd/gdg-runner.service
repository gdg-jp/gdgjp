[Unit]
Description=GDG Japan knowledge runner (gdg wiki runner)
After=network-online.target
Wants=network-online.target

[Service]
User=runner
Group=runner
EnvironmentFile=/etc/gdg/runner.env
ExecStart=/usr/local/bin/gdg wiki runner
WorkingDirectory=/var/lib/gdg-runner
Restart=always
RestartSec=10
# The runner and the agent only need their workdir and ~/.codex.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
